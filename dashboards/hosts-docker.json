{
  "uid": "agent-lab-hosts",
  "title": "Agent Lab — Hosts & Docker",
  "tags": ["agent-lab", "node-exporter", "proxmox"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Host metrics from node_exporter: salvor (Proxmox VE, ZFS) and gadfium (Ubuntu 24.04 desktop with AMD iGPU, Docker + KVM). No cAdvisor/container exporter is running, so per-container CPU/memory is NOT available — the 'Docker' part of this dashboard is intentionally absent; see PROGRESS.md.",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
        "query": { "query": "label_values(node_cpu_seconds_total, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "CPU usage",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 70 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "(1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}[5m]))) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "red", "value": 95 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "(node_memory_MemTotal_bytes{instance=~\"$host\"} - node_memory_MemAvailable_bytes{instance=~\"$host\"}) / node_memory_MemTotal_bytes{instance=~\"$host\"} * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "blue", "value": null }] }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "time() - node_boot_time_seconds{instance=~\"$host\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "ZFS ARC hit ratio (salvor)",
      "description": "rate(hits) / (rate(hits)+rate(misses)) over 5m. Prefetch misses are included; values near 100% are healthy.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.9 },
              { "color": "green", "value": 0.98 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "rate(node_zfs_arc_hits{instance=~\"$host\"}[5m]) / (rate(node_zfs_arc_hits{instance=~\"$host\"}[5m]) + rate(node_zfs_arc_misses{instance=~\"$host\"}[5m]))",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "CPU usage over time",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "(1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\", instance=~\"$host\"}[5m]))) * 100",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Load average",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_load1{instance=~\"$host\"}",
          "legendFormat": "{{instance}} 1m",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_load5{instance=~\"$host\"}",
          "legendFormat": "{{instance}} 5m",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_load15{instance=~\"$host\"}",
          "legendFormat": "{{instance}} 15m",
          "refId": "C"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Memory used",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_memory_MemTotal_bytes{instance=~\"$host\"} - node_memory_MemAvailable_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}} used",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Disk usage (top 12 filesystems)",
      "description": "(size - free) / size for ext4/xfs/zfs mounts. topk keeps the panel readable despite salvor's many rpool subvol mounts.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.8 },
              { "color": "red", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "topk(12, (node_filesystem_size_bytes{instance=~\"$host\", fstype=~\"ext4|xfs|zfs\"} - node_filesystem_free_bytes{instance=~\"$host\", fstype=~\"ext4|xfs|zfs\"}) / node_filesystem_size_bytes{instance=~\"$host\", fstype=~\"ext4|xfs|zfs\"})",
          "legendFormat": "{{instance}} {{mountpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Disk I/O (top devices)",
      "description": "Read/write bytes per second on whole disks (partitions excluded). topk(8) hides the quiet ZFS vdevs.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "topk(8, rate(node_disk_read_bytes_total{instance=~\"$host\", device!~\".*p[0-9]+$\"}[5m]))",
          "legendFormat": "{{instance}} {{device}} read",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "topk(8, rate(node_disk_written_bytes_total{instance=~\"$host\", device!~\".*p[0-9]+$\"}[5m]))",
          "legendFormat": "{{instance}} {{device}} write",
          "refId": "B"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Network receive (top interfaces)",
      "description": "topk(8) by current rate — hides the many quiet bridges on both hosts.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "topk(8, rate(node_network_receive_bytes_total{instance=~\"$host\", device!=\"lo\"}[5m]) * 8)",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Network transmit (top interfaces)",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "topk(8, rate(node_network_transmit_bytes_total{instance=~\"$host\", device!=\"lo\"}[5m]) * 8)",
          "legendFormat": "{{instance}} {{device}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "GPU busy % (gadfium)",
      "description": "node_drm_gpu_busy_percent on the AMD card. On an integrated GPU this includes display-engine activity, so a persistently high value is expected while a desktop session is attached.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_drm_gpu_busy_percent{instance=~\"$host\"}",
          "legendFormat": "{{instance}} {{card}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GPU VRAM (gadfium)",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 8, "x": 16, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_drm_memory_vram_used_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}} used",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_drm_memory_vram_size_bytes{instance=~\"$host\"}",
          "legendFormat": "{{instance}} size",
          "refId": "B"
        }
      ]
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Max temperature per host",
      "description": "Hottest hwmon/thermal-zone sensor. gadfium has been sitting around 90C at near-idle load — investigate cooling (dust, thermal paste).",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 65 },
              { "color": "red", "value": 80 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "max by (instance) (node_hwmon_temp_celsius{instance=~\"$host\"}) or max by (instance) (node_thermal_zone_temp{instance=~\"$host\"})",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "ZFS ARC size (salvor)",
      "description": "Current ARC cache size vs configured maximum.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 34 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_zfs_arc_size{instance=~\"$host\"}",
          "legendFormat": "{{instance}} ARC",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "node_zfs_arc_c_max{instance=~\"$host\"}",
          "legendFormat": "{{instance}} max",
          "refId": "B"
        }
      ]
    }
  ]
}
