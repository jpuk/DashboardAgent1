{
  "uid": "agent-lab-reachability",
  "title": "Agent Lab — Network Reachability",
  "tags": ["agent-lab", "blackbox"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 0,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "description": "Blackbox probe health for all probed targets: success rate, latency, DNS lookup time and ICMP hop limit. Data source: Prometheus (job=blackbox). Targets are IP-only in the scrape config.",
  "templating": {
    "list": [
      {
        "name": "target",
        "label": "Target",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
        "query": { "query": "label_values(probe_success, instance)", "refId": "StandardVariableQuery" },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": { "text": ["All"], "value": ["$__all"] }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Probe success (1h avg)",
      "description": "Fraction of successful probes per target over the last hour. Below 95% is red.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "avg_over_time(probe_success{instance=~\"$target\"}[1h])",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Last probe latency",
      "description": "Duration of the most recent successful probe per target.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_duration_seconds{instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Fleet status",
      "description": "Number of probed targets and the worst 1h success rate across them.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 4, "w": 8, "x": 16, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.95 },
              { "color": "green", "value": 0.995 }
            ]
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "targets" },
            "properties": [
              { "id": "unit", "value": "short" },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [{ "color": "blue", "value": null }]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "auto",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto"
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "count(probe_success)",
          "legendFormat": "targets",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "min(avg_over_time(probe_success[1h]))",
          "legendFormat": "worst 1h success",
          "refId": "B"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Probe success over time",
      "description": "1 = reachable on that probe, 0 = failed. Gaps mean the probe did not run.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": [] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_success{instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Probe latency",
      "description": "End-to-end probe duration per target. External resolvers sit around 20 ms; internal targets well under 1 ms.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_duration_seconds{instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "DNS lookup time during probe",
      "description": "Time the blackbox module spent resolving the target hostname (sub-microsecond values = local/instant resolution). Watch for slow or failing lookups.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_dns_lookup_time_seconds{instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "ICMP reply hop limit (TTL)",
      "description": "TTL of the ICMP echo reply. A sudden drop means the route to the target changed (extra hops added).",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "showPoints": "auto",
            "spanNulls": true,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "calcs": ["lastNotNull"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_icmp_reply_hop_limit{instance=~\"$target\"}",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "type": "table",
      "title": "Target status",
      "description": "Current scrape state, last latency, hop limit and DNS lookup time per target.",
      "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "up" },
            "properties": [
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    { "color": "red", "value": null },
                    { "color": "green", "value": 1 }
                  ]
                }
              },
              { "id": "unit", "value": "boolean" }
            ]
          },
          {
            "matcher": { "id": "byName", "options": "latency (last)" },
            "properties": [{ "id": "unit", "value": "s" }]
          },
          {
            "matcher": { "id": "byName", "options": "dns lookup (last)" },
            "properties": [{ "id": "unit", "value": "s" }]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [{ "desc": false, "displayName": "instance" }]
      },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "up{job=\"blackbox\", instance=~\"$target\"}",
          "format": "table",
          "instant": true,
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_duration_seconds{instance=~\"$target\"}",
          "format": "table",
          "instant": true,
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_icmp_reply_hop_limit{instance=~\"$target\"}",
          "format": "table",
          "instant": true,
          "refId": "C"
        },
        {
          "datasource": { "type": "prometheus", "uid": "cg08tpxzt30u8d" },
          "expr": "probe_dns_lookup_time_seconds{instance=~\"$target\"}",
          "format": "table",
          "instant": true,
          "refId": "D"
        }
      ]
    }
  ]
}
